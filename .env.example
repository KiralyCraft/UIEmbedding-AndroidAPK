# Use alphanumeric/hex secrets here: DATABASE_URL interpolates these without URL encoding.
# Generate separately: python -c 'import secrets; print(secrets.token_hex(32))'
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
# Address of your reverse proxy as seen inside the API container. Do NOT use '*'.
TRUSTED_PROXY_IPS=127.0.0.1
